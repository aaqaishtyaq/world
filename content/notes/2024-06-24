
How to download pdf from a website

```javascript
// Function to fetch binary data and save as PDF
async function saveBinaryAsPDF(url, filename, headers) {
    try {
        // Fetch the binary data
        const response = await fetch(url, headers);
        const blob = await response.blob();
        // Create a URL for the Blob
        const blobURL = window.URL.createObjectURL(blob);
        // Create an anchor element and trigger a download
        const a = document.createElement('a');
        a.href = blobURL;
        a.style.display = 'none';
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        // Clean up
        document.body.removeChild(a);
        window.URL.revokeObjectURL(blobURL);
    } catch (error) {
        console.error('Error fetching and saving PDF:', error);
    }
}

